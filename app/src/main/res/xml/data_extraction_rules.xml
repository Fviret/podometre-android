<?xml version="1.0" encoding="utf-8"?>
<!--
    Règles de sauvegarde et de transfert appareil (API 31+).
    journey_progress.json est exclu des deux : les données sont recalculées depuis Health Connect.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="journey_progress.json" />
        <exclude domain="file" path="journey_progress.json.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="journey_progress.json" />
        <exclude domain="file" path="journey_progress.json.tmp" />
    </device-transfer>
</data-extraction-rules>
