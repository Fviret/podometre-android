<?xml version="1.0" encoding="utf-8"?>
<!--
    Premier plan de l'icône adaptative (KAN-149).

    Composition (zone sûre : 72×72dp centrée dans le canvas 108×108dp) :
      1. Anneau de progression 300° (lacune en bas) — dégradé vert → bleu, cap arrondi
      2. Silhouette de montagne — triangle blanc centré dans l'anneau
      3. Capuchon de neige — pointe bleu-blanc clair
      4. Sentier de pas — 4 cercles blancs semi-transparents en zigzag montant

    Couleurs de l'anneau identiques à AppColors.ringColorOptions (CLAUDE.md) :
      - green : #33C759
      - blue  : #3399F2

    Géométrie de l'anneau :
      Centre (54, 54), rayon 32, épaisseur trait 8.
      Début à 120° (bas-gauche) : (38, 81.7)
      Fin   à  60° (bas-droite) : (70, 81.7)
      Arc SVG : M 38,81.7 A 32,32 0 1 1 70,81.7
      (large-arc-flag=1, sweep=1 → sens horaire, 300°)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Anneau de progression 300° avec dégradé vert → bleu -->
    <path
        android:pathData="M 38,81.7 A 32,32 0 1 1 70,81.7"
        android:fillColor="#00000000"
        android:strokeWidth="8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                xmlns:android="http://schemas.android.com/apk/res/android"
                android:type="linear"
                android:startX="22"
                android:startY="54"
                android:endX="86"
                android:endY="54">
                <item android:offset="0.0" android:color="#FF33C759" />
                <item android:offset="1.0" android:color="#FF3399F2" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Corps de la montagne -->
    <path
        android:pathData="M 54,30 L 32,60 L 76,60 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- Capuchon de neige (pointe) -->
    <path
        android:pathData="M 54,30 L 48,42 L 60,42 Z"
        android:fillColor="#FFD6EEFF" />

    <!-- Sentier de pas : 4 empreintes en zigzag, du bas vers la montagne -->
    <path
        android:pathData="M 41.5,77 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0"
        android:fillColor="#B3FFFFFF" />
    <path
        android:pathData="M 59.5,73 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0"
        android:fillColor="#B3FFFFFF" />
    <path
        android:pathData="M 43.5,67 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0"
        android:fillColor="#B3FFFFFF" />
    <path
        android:pathData="M 57.5,63 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0"
        android:fillColor="#B3FFFFFF" />
</vector>
